generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  gstin     String?
  state     String   @default("Uttar Pradesh")
  invoicePrefix  String  @default("INV")
  invoiceCounter Int     @default(1)
  financialYear  String  @default("2526")
  logo      String?
  signature String?

  // Subscription state — see src/modules/plan. These fields decide what a
  // company pays for, so only admin/billing code may ever write them. No
  // customer-facing endpoint should accept them (updateCompany copies its
  // fields one by one for exactly this reason). Limits and features are NOT
  // stored here; they live in plan.config.js.
  plan          Plan          @default(FREE)
  billingStatus BillingStatus @default(ACTIVE)
  planStartedAt DateTime      @default(now())
  planExpiresAt DateTime?     // NULL means "never expires". Never use a far-future date for that.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  products   Product[]
  customers  Customer[]
  invoices   Invoice[]
}

enum Plan {
  FREE
  STARTER
  PRO
}

// Deliberately a separate axis from Plan: PRO + COMPED (a free pilot) is as
// valid as PRO + ACTIVE (a paying customer). Don't assume a plan implies
// payment, and keep DB constraints loose so future transitions stay easy.
enum BillingStatus {
  TRIALING
  ACTIVE
  COMPED
  EXPIRED
  CANCELLED
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  password      String?
  role          Role      @default(STAFF)
  isActive      Boolean   @default(false)
  inviteToken   String?   @unique
  inviteExpiry  DateTime?

  // Stores a SHA-256 HASH of the reset token, never the raw token — see
  // auth.service.js. Higher-stakes than inviteToken (this can take over an
  // already-active account), so it gets the stricter treatment: even a full
  // database leak wouldn't hand out usable reset tokens.
  resetPasswordTokenHash String?   @unique
  resetPasswordExpiry    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  invoices  Invoice[]
}

enum Role {
  OWNER
  STAFF
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String?
  mrp         Float?    // Maximum Retail Price
  price       Float     // Selling price
  priceType   PriceType @default(EXCLUSIVE)
  stock       Int       @default(0)
  unit        String?   // unit code e.g. KGS, PCS, MLT
  netQuantity Float?    // e.g. 500 for 500g
  ean         String?
  hsn         String?
  image       String?
  tax         Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId    String
  company      Company @relation(fields: [companyId], references: [id])
  invoiceItems InvoiceItem[]
}

enum PriceType {
  INCLUSIVE
  EXCLUSIVE
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  state     String   @default("Uttar Pradesh")
  phone     String?
  address   String?
  shipToAddress String?
  gstin     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  invoices  Invoice[]
}

model Invoice {
  id          String        @id @default(uuid())
  invoiceNo   String
  status      InvoiceStatus @default(UNPAID)
  subtotal    Float         // total before tax
  cgst        Float?        // 50% of tax for intra-state
  sgst        Float?        // 50% of tax for intra-state
  igst        Float?        // full tax for inter-state
  taxAmount   Float         // total tax amount
  totalAmount Float         // final total after tax
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  items       InvoiceItem[]
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id        String @id @default(uuid())
  quantity  Int
  unitPrice Float
  tax       Float?  // tax percentage for this item
  cgst      Float?  // cgst amount for this item
  sgst      Float?  // sgst amount for this item
  igst      Float?  // igst amount for this item
  total     Float   // final total including tax

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
}